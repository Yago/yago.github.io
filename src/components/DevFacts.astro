---
import DevFactsReact from '@/components/DevFacts';
---

<div class="dev-facts">
  <DevFactsReact client:visible />
</div>

<style is:global>
  .dev-facts {
    text {
      font-family: 'Fira Code VF', 'SFMono-Regular', 'Menlo', 'Monaco',
        'Consolas', 'Liberation Mono', 'Courier New', monospace;
      font-size: 0.5em;
      fill: currentColor;
    }

    .contrib-graph .contrib-0 {
      fill: #171b21;
    }
    .contrib-graph .contrib-1 {
      fill: #143722;
    }
    .contrib-graph .contrib-2 {
      fill: #275e32;
    }
    .contrib-graph .contrib-3 {
      fill: #459548;
    }
    .contrib-graph .contrib-4 {
      fill: #67d15a;
    }

    .contrib-graph .contrib-label {
      fill: currentColor;
      font-size: 9px;
    }
  }

  .dark .dev-facts {
    .contrib-graph .contrib-0 {
      fill: #e7e9f1;
    }
    .contrib-graph .contrib-1 {
      fill: #9be9a8;
    }
    .contrib-graph .contrib-2 {
      fill: #41c464;
    }
    .contrib-graph .contrib-3 {
      fill: #31a14e;
    }
    .contrib-graph .contrib-4 {
      fill: #206e39;
    }
  }
</style>
