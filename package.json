{
  "name": "yanngouffon.com",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "icons:build": "svg-sprite -s --symbol-inline --symbol-dest public --symbol-sprite icons.svg src/assets/icons/*.svg",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run contribs:update && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint:js": "eslint --ext js,jsx,ts,tsx,astro ./ --max-warnings=0",
    "fix:js": "eslint --ext js,jsx,ts,tsx,astro ./ --max-warnings=0 --fix",
    "config:update": "./bin/updatePictureDb.js",
    "contribs:update": "./bin/updateContribDb.js",
    "postinstall": "husky install",
    "prepublishOnly": "pinst --disable",
    "postpublish": "pinst --enable"
  },
  "dependencies": {
    "@astrojs/alpinejs": "^0.4.0",
    "@astrojs/check": "^0.5.10",
    "@astrojs/mdx": "^2.2.2",
    "@astrojs/react": "^3.1.0",
    "@astrojs/tailwind": "^5.1.0",
    "@astrojs/vercel": "^7.5.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.12",
    "@types/alpinejs": "^3.13.10",
    "@types/react": "^18.2.73",
    "@types/react-dom": "^18.2.23",
    "alpinejs": "^3.13.7",
    "astro": "^4.5.12",
    "axios": "^1.6.8",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "graphql-request": "^6.1.0",
