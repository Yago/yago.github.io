    "ramda": "^0.29.1",
    "react": "^18.2.0",
    "react-calendar-heatmap": "^1.9.0",
    "react-dom": "^18.2.0",
    "react-minimal-pie-chart": "^8.4.0",
    "react-terminal-component": "^1.5.0",
    "shiki": "^1.2.2",
    "tailwind-merge": "^2.2.2",
    "tailwind-underline-utils": "^1.1.3",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.3",
    "vanilla-tilt": "^1.8.1"
