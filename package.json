{
  "name": "yanngouffon.com",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "icons:build": "svg-sprite -s --symbol-inline --symbol-dest public --symbol-sprite icons.svg src/assets/icons/*.svg",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run contribs:update && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint:js": "eslint --ext js,jsx,ts,tsx,astro ./ --max-warnings=0",
    "fix:js": "eslint --ext js,jsx,ts,tsx,astro ./ --max-warnings=0 --fix",
    "config:update": "./bin/updatePictureDb.js",
    "contribs:update": "./bin/updateContribDb.js",
    "postinstall": "husky install",
    "prepublishOnly": "pinst --disable",
    "postpublish": "pinst --enable"
  },
  "dependencies": {
    "@astrojs/alpinejs": "0.4.9",
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "4.3.5",
    "@astrojs/react": "4.3.1",
    "@astrojs/tailwind": "6.0.2",
    "@astrojs/vercel": "8.2.7",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/postcss": "^4.1.13",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.13",
    "@types/alpinejs": "^3.13.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "alpinejs": "^3.14.3",
    "astro": "5.13.7",
    "axios": "^1.7.7",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "graphql-request": "^7.1.2",
    "javascript-terminal": "^1.1.1",
    "photoswipe": "^5.4.4",
    "ramda": "^0.30.1",
    "react": "^18.3.1",
    "react-calendar-heatmap": "^1.9.0",
    "react-dom": "^18.3.1",
    "react-minimal-pie-chart": "^8.4.1",
    "react-terminal-component": "^1.5.0",
    "shiki": "^1.23.1",
    "tailwind-merge": "^2.5.4",
    "tailwind-underline-utils": "^1.1.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.6.3",
    "vanilla-tilt": "^1.8.1"
